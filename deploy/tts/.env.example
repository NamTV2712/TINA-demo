# Reference for private overrides; run.py reads encrypted deploy/tts/.env by default.
# Obtain ~/.config/tina/tts.env.keys privately; never commit or paste its contents.
# TTS_API_TOKEN below is generated locally and encrypted before sharing an env file.
TTS_API_TOKEN=
# These non-secret overrides belong in the caller's environment, not the shared token file.
# Default: each user's ~/.cache/tina/tts (no machine-specific path in shared .env).
TINA_TTS_MODELS=/absolute/path/to/tina-tts-models
TINA_MAIN_NETWORK=tina-local_tina
TINA_TTS_HOST_PORT=18004
