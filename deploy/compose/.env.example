# =============================================================================
# TINA open-core — compose environment. Copy to .env:  cp .env.example .env
# `make all` copies this automatically on first run if .env is absent.
# Infra defaults below are dev-safe; fill the CREDENTIALS block for full function.
# =============================================================================

# --- project + host ports ----------------------------------------------------
# NOTE: keep comments on their OWN line, never trailing a value. This file is consumed by
# `docker run --env-file` (deploy/lite), whose parser does NOT strip an inline comment — it becomes
# part of the value. A trailing comment here once made Lite's `docker run` word-split a bare `#`
# into the image slot ("docker: invalid reference format"), and shipped commented-out ports as
# literal values.
COMPOSE_PROJECT_NAME=tina-v012
# Optional machine binding, e.g. desktop-linux or orbstack. The entrypoint pins context
# and Buildx for each run; it never switches your global Docker context.
# DOCKER_CONTEXT=desktop-linux
# Optional profiles, persisted for repeated make all/down/doctor calls: automation,asr,dashboard,
# mailbox,discord. Gipformer Compose mode uses the ASR model files in deploy/transcription/models.
COMPOSE_PROFILES=
# Optional override chain (colon-separated; paths relative to deploy/compose).
# COMPOSE_FILE=docker-compose.yml:/absolute/path/to/machine-override.yml
# API gateway (all docs/SDK calls target this)
API_GATEWAY_HOST_PORT=18056
# admin-api (mint API keys)
ADMIN_API_PORT=18057
# Optional server-side account binding for native Desktop capture and final-text polish.
# Empty follows Global ASR defaults; dictation uses raw ASR text when polish is not configured.
TINA_DESKTOP_API_KEY=
# Optional override for the host Desktop's authenticated Agent API polish bridge.
TINA_GATEWAY_URL=
MEETING_API_PORT=18080
RUNTIME_API_PORT=18090
AGENT_API_PORT=18100
# the terminal workbench UI → http://localhost:13000
TERMINAL_PORT=13000
POSTGRES_HOST_PORT=5458
# the storage service's S3 port, loopback only (make login uploads a bot session through it)
STORAGE_HOST_PORT=18900

# --- images ------------------------------------------------------------------
IMAGE_TAG=v012

# The build stamp agent-api reports on GET /api/version and the terminal's reload bar compares
# against (PRD decision 39). Empty -> falls back to IMAGE_TAG, which is what a plain `up -d`
# should say. The blue/green deploy sets it per swap.
TINA_BUILD_SHA=
# make all builds source images with IMAGE_TAG=dev unless explicitly overridden in the shell.
# Direct docker compose commands use IMAGE_TAG above. TINA does not publish these images.
BROWSER_IMAGE=tina/tina-bot:${IMAGE_TAG}
DOCKER_GID=0
LOG_LEVEL=info

# --- database ----------------------------------------------------------------
DB_NAME=tina
DB_USER=postgres
DB_PASSWORD=postgres

# --- object storage (the `storage` service: versitygw) -----------------------
# meeting-api keeps the MINIO_* names. ACCESS/SECRET are the storage server's root credentials:
# change both for any non-local deploy. MINIO_ENDPOINT (host:port) is where meeting-api stores
# recordings: storage:9000 is the in-stack service; set your own S3's host:port to use that instead.
# Upgrading an install that ran MinIO: /upgrade-from-minio
MINIO_ACCESS_KEY=tina-access-key
MINIO_SECRET_KEY=tina-secret-key
MINIO_BUCKET=tina
MINIO_ENDPOINT=storage:9000
MINIO_SECURE=false

# --- stack secrets (CHANGE for any non-local deploy) -------------------------
# admin-api auth; `make all` mints your API key with this. THE SAME VALUE reaches meeting-api as
# ADMIN_TOKEN, where it HS256-signs every per-spawn MeetingToken — one credential, two spellings.
# It MINTS AN API KEY FOR ANY USER, so it is the largest single secret in the stack. compose used
# to fall back to `changeme` when this was unset; it no longer does, and admin-api and meeting-api
# refuse published placeholders. make all mints this for a new install. Existing valid secrets
# are preserved; replacing an old placeholder on an existing install is an explicit migration.
ADMIN_TOKEN=
# The INTERNAL TIER: services present it as X-Internal-Secret and agent-api/admin-api believe
# it as authority (the meeting room's gate 0). It shipped here as a literal, which meant every
# unconfigured deploy shared one published secret — mint your own, there is no default and the
# services refuse to boot without it:  openssl rand -hex 32
INTERNAL_API_SECRET=
# The deployment profile — the same word the mcp and transcription services read. Anything but
# `production` (including unset) is a development posture: generated store key, public docs.
TINA_ENV=development
# The bot's display name in the meeting — the terminal omits bot_name on join, so this names every
# bot it sends. Empty → TINA. Restart meeting-api after changing; the terminal needs no rebuild.
DEFAULT_BOT_NAME=
TINA_DISPATCH_SIGNING_KEY=dev-dispatch-signing-key
NEXTAUTH_SECRET=dev-nextauth-secret
# NEXTAUTH_URL — public origin when behind a domain/reverse-proxy (e.g. https://tina.example.test).
# Required for OAuth login; an https:// value also flips the auth cookies to Secure.
NEXTAUTH_URL=

# OAuth login providers (terminal sign-in buttons). Each self-gates on its creds: set BOTH id+secret
# to expose that provider; leave empty to hide it (the dev type-any-email login always works).
# Register the redirect URI in the provider console: ${NEXTAUTH_URL}/api/auth/callback/{google|microsoft}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = work/school + personal; or an org tenant id
MICROSOFT_TENANT_ID=common

# Google Analytics 4 (terminal web usage). Set to your measurement id (G-XXXXXXXXXX) to turn on
# frontend analytics — page views + an `api_request` event per web-client API call. Baked into the
# client bundle at BUILD time, so rebuild the terminal image after changing it. Empty → GA stays off.
GA_MEASUREMENT_ID=

# --- CREDENTIALS — fill these for transcription + agent intelligence ---------
# Transcription (STT): base URL; the client appends /v1/audio/transcriptions. For Compose Gipformer,
# enable profiles `asr,automation,dashboard`, use http://gipformer:8000, and copy the private host
# Gipformer token into TRANSCRIPTION_SERVICE_TOKEN. Its model-install job fills
# deploy/transcription/models/gipformer-fsmn automatically. The separate Faster-Whisper stack remains available at
# deploy/transcription. Without a reachable endpoint + matching token, bots join + record but produce
# no transcript.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=
# Managed VieGem credential. Encrypt with dotenvx; make all resolves auto MPS/CUDA for the current host.
TINA_VIEGEM_TOKEN=
# make all: auto selects native MPS on Apple Silicon or Docker CUDA on Linux/WSL2.
# No automatic CPU fallback. Set cpu explicitly for the optional CPU container.
TINA_VIEGEM_DEVICE=auto
# Host lifecycle controller, private authenticated edge used by Terminal (not a browser URL).
TINA_ASR_CONTROL_PORT=18007
# STT model id sent on every transcription request (the OpenAI-compatible `model` field). Set it
# when the backend VALIDATES model ids — Groq (whisper-large-v3-turbo), OpenAI (whisper-1),
# vLLM/LiteLLM (the served name). Empty → whisper-1. Gipformer accepts `custom`, `whisper-1`, or its
# pinned model id; its model is fixed by the model assets, not this field.
TRANSCRIPTION_MODEL=
# Optional Speak/TTS endpoint: OpenAI-compatible `/v1/audio/speech` returning mono PCM16 at 24 kHz.
# Setting this enables Speak for manually created bots. Keep its token server-side; it is passed only
# to voice-enabled bot workloads and is never sent to the Dashboard bundle.
TTS_SERVICE_URL=
TTS_API_TOKEN=
# Optional forced alignment (MFA Vietnamese model). The worker binds to host loopback :18015;
# from Meeting API inside Compose, set ALIGNMENT_SERVICE_URL=http://host.docker.internal:18015.
# The service preserves each raw token, reports its model/audio hashes, and marks OOV words unaligned.
ALIGNMENT_SERVICE_URL=
ALIGNMENT_SERVICE_TOKEN=
# Deployment-level defaults for a spawn's flags when the request does not say (config.v1 `defaulted`).
# TRANSCRIBE_ENABLED=false makes a no-STT deployment spawn capture-only bots instead of 503-ing every
# default POST /bots. Both default true — and LEFT EMPTY BELOW STILL MEANS true: only an explicit
# false/0/no/off opts out. (Empty used to resolve False on the `--env-file` path, silently shipping
# capture-only bots that transcribed nothing with no error — the v0.12.5 witness bug.)
TRANSCRIBE_ENABLED=
RECORDING_ENABLED=
# Authenticated-bot mode (deployment-scoped; docs: /authenticated-bots). BOT_AUTHENTICATED=true
# makes every spawned bot restore the provisioned browser session (make login) and join signed-in.
# BOT_S3_* are SCOPED userdata-store credentials — never the deployment's admin S3 creds. With
# BOT_S3_ENDPOINT=http://storage:9000 the storage-init step creates that key pair as an account on
# the in-stack storage and limits it to BOT_USERDATA_S3_PATH with a bucket policy.
BOT_AUTHENTICATED=
BOT_USERDATA_S3_PATH=
BOT_S3_ENDPOINT=
BOT_S3_BUCKET=
BOT_S3_ACCESS_KEY=
BOT_S3_SECRET_KEY=
# Optional generic service authority. Unset preserves the stock OSS allow-all behavior. When set,
# CONFIG is one compact JSON object with url/contract_version/timeout_ms/
# response_max_age_seconds/failure_policy=closed/mode=enforce|observe. SECRET signs exact request
# bytes; keep it out of source and shell history in real deployments.
TINA_SERVICE_AUTHORITY_CONFIG=
TINA_SERVICE_AUTHORITY_SECRET=
# Optional operator-owned terminal callback. Unlike the customer webhook, this destination is
# frozen at boot. Private HTTP requires the explicit opt-in; keep the secret out of source/history.
TINA_SYSTEM_WEBHOOK_URL=
TINA_SYSTEM_WEBHOOK_SECRET=
TINA_SYSTEM_WEBHOOK_ALLOW_PRIVATE_HTTP=false
TINA_SYSTEM_WEBHOOK_TIMEOUT_S=10
BOT_ALONE_SILENCE_WINDOW_MS=
BOT_SPEAKER_MIN_AUDIO_SEC=
BOT_SPEAKER_SUBMIT_INTERVAL_SEC=
BOT_SPEAKER_CONFIRM_THRESHOLD=
BOT_SPEAKER_MAX_BUFFER_SEC=
BOT_SPEAKER_IDLE_TIMEOUT_SEC=
# Self-hosted Jitsi hostnames (comma-separated, e.g. calls.example.org) recognized when parsing
# pasted meeting links AND calendar (ICS) links. meet.jit.si and hosts naming "jitsi" are always
# recognized; hosts with a "meet" label (meet.example.org, eu.meet.example.org) are recognized in
# pasted links. List a host here to make its calendar invites import as joinable Jitsi meetings.
TINA_JITSI_HOSTS=

# ─── Discord (optional, opt-in compose profile) ─────────────────────────────────────────────────
# Discord is a LONG-LIVED connector, not a per-meeting container: one bot token holds exactly one
# Gateway session, so it runs as exactly ONE replica (compose: `--profile discord`). Leave the
# token empty to keep it off.
#   1. https://discord.com/developers/applications → New Application → Bot → copy the token.
#   2. Bot → Privileged Gateway Intents → enable SERVER MEMBERS INTENT (display names — without
#      it the connector refuses its login rather than labelling every speaker with a user id).
#   3. Installation → Guild Install → scopes: bot; permissions: View Channels, Connect, Speak.
#      Invite it to the server(s) whose voice channels it may join.
#   4. docker compose --profile discord up -d --build
# Transcription of a voice channel is still a recording of people's voices: tell participants the
# bot is present and what it does. Joining a channel is visible to everyone in it.
DISCORD_BOT_TOKEN=
# Comma-separated guild snowflakes allowed to receive the bot. EMPTY = EVERY guild the bot is in —
# convenient single-tenant, wrong for a bot shared across servers. Recommended: list them.
DISCORD_GUILD_ALLOWLIST=
# Ceilings: concurrent voice sessions; per-session speaker lanes (LRU beyond this).
DISCORD_MAX_SESSIONS=4
DISCORD_MAX_CHANNELS=16
# meeting-api's dispatch address for `discord-bot` workloads (the connector's runtime.v1 surface).
# Empty disables the Discord branch entirely.
DISCORD_CONNECTOR_URL=http://discord-connector:8091

# Completion adapter for plain model calls. Chat/workspace agent turns use the separate
# TINA_RUNNER harness; model settings can override these deployment defaults.
TINA_LLM_PROVIDER=
TINA_LLM_MAX_TOKENS=
TINA_LLM_BASE_URL=
TINA_LLM_API_KEY=
TINA_LLM_MODEL=
# Optional operator gate on workspace-pinned models (comma-separated; empty = allow any route).
TINA_MODEL_ALLOWLIST=
# The agent HARNESS for workspace turns (chat / routines / post-meeting docs).
# Harness runner: claude-code (default) | codex (Codex app-server) | antigravity (agy CLI).
TINA_RUNNER=
# Server-owned JSON array of tool.v1 names available to interactive chat (empty disables MCP tools).
TINA_CHAT_TOOLBELT=[]

# Credentials for the claude-code harness ONLY (unused by other runners). Without them,
# capture + transcripts work but agent chat / workspace turns do not.
# Two delivery mechanisms into spawned workers:
#   1) env passthrough — agent-api stamps the model-auth allowlist (CLAUDE_CODE_OAUTH_TOKEN,
#      ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL) from its own env into
#      every dispatch spec env. Works on EVERY runtime
#      backend (docker/compose, k8s/helm, process/lite) — on helm it is the ONLY path.
#   2) HOST_CLAUDE_CREDENTIALS bind-mount (docker backend only, "optional" below) — the runtime
#      mounts a host ~/.claude/.credentials.json read-only into the worker.
# If both are configured, the claude CLI prefers its env credential over the mounted file —
# configure exactly one to avoid ambiguity.
# CLAUDE_CODE_OAUTH_TOKEN = the claude CLI subscription OAuth token (env twin of the mount).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
TINA_AGENT_MODEL=
TINA_MEETING_MODEL=
TINA_AGENT_DEFAULT_SUBJECT=u_live

# Antigravity CLI (agy) credentials. GEMINI_API_KEY is the deployment fallback for users selecting
# Antigravity in Settings → Models. Consumer-plan Antigravity login through TINA violates Google's
# Terms and may result in suspension; Settings requires a warning acknowledgment. Empty auth mode
# infers Gemini API key when present.
GEMINI_API_KEY=
TINA_ANTIGRAVITY_AUTH_MODE=
TINA_ANTIGRAVITY_TERMS_ACKNOWLEDGED=

# --- optional ----------------------------------------------------------------
# Bot API key — fallback auth for the terminal's proxy auth chain:
# cookie token → TINA_API_KEY → TINA_BOT_API_KEY → "". Set to a token minted
# by `make provision-token` (same scopes: bot,tx). Leave empty if unused.
TINA_BOT_API_KEY=
TINA_AGENT_SRC_MOUNT=

# Claude SUBSCRIPTION credentials for agent workers (the claude-code runner's no-API-key path).
# HOW IT WORKS (explicit + deterministic — config.v1 `model_inference` capability):
#   1. Set this to a path ON THE DOCKER HOST (not inside any container) of a claude credentials
#      JSON — typically $HOME/.claude/.credentials.json after `claude login` on the host.
#   2. The runtime bind-mounts that host file READ-ONLY into EVERY spawned agent-worker at
#      /root/.claude/.credentials.json (core/runtime docker backend); the worker's claude CLI
#      authenticates from it. No key material passes through env.
#   3. The same path is mirror-mounted into the runtime container so its config.v1 file probe can
#      verify the file exists + parses; a bad path shows as `model_inference: misconfigured` on the
#      runtime's /health (docker silently turns a missing host path into an empty directory in the
#      worker, which otherwise only surfaces as 'Model inference failed: Not logged in' at chat time).
# macOS ONLY: the CLI's real store is the login Keychain — this file is a one-time export that
# expires every ~8-12h (agent chat then 401s while `claude` still works). Install the bundled
# refresher once: deploy/bin/claude-creds-sync/install.sh (Linux/WSL2 need nothing — the CLI
# refreshes the file itself). See deploy/bin/claude-creds-sync/README.md.
# Alternative credential path: leave this empty and set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN
# (+ ANTHROPIC_BASE_URL) above — the runtime brokers those into workers as env instead.
HOST_CLAUDE_CREDENTIALS=

# agent-api → meeting-api (SSE stream ownership check)
TINA_MEETING_API_URL=http://meeting-api:8080

# --- gateway edge guard (fastapi-guard) ---------------------------------------
# Per-IP rate limiting + auto-IP-ban at the gateway edge. ON BY DEFAULT with generous limits
# (600 requests/min per IP) — to opt OUT, uncomment GUARD_ENABLED=false. All GUARD_* keys below
# interpolate into the gateway service via docker-compose.yml (`${VAR:-default}`), so setting any
# of them in this file takes effect on the next `docker compose up`.
# GUARD_WS_ENABLED is the optional /ws connect guard (off by default, opt-in): in-memory
# per-process — does NOT share ban/rate-limit state with the Redis-backed HTTP layer, and under
# uvicorn --workers N>1 each worker keeps an independent WS ban set. See
# core/gateway/services/gateway/src/gateway/edge_guard.py for the full GUARD_* surface.
#GUARD_ENABLED=false              # uncomment to turn the edge guard OFF
#GUARD_WS_ENABLED=false
#GUARD_ENABLE_REDIS=true          # reuse REDIS_URL for guard state (tina:guard: namespace)
#GUARD_RATE_LIMIT_RPM=600         # per-IP requests per minute (0 disables rate limiting)
#GUARD_RATE_LIMIT_WINDOW=60
#GUARD_AUTO_BAN_THRESHOLD=10
#GUARD_AUTO_BAN_DURATION=3600
#GUARD_IP_BLACKLIST=             # comma-separated IPs to block (403)
#GUARD_IP_WHITELIST=             # comma-separated IPs to bypass the guard
#GUARD_TRUSTED_PROXIES=          # comma-separated trusted proxy IPs (enables X-Forwarded-For resolution)
#GUARD_BLOCKED_COUNTRIES=
#GUARD_BLOCK_CLOUD_PROVIDERS=

# --- Deprecated 0.10 dashboard (opt-in: docker compose --profile dashboard up -d) — #813 ---
# Pinned external image + host port; public URLs only matter behind a domain/reverse-proxy.
# DASHBOARD_IMAGE=tina/dashboard:0.10.6.3.14
# DASHBOARD_PORT=13001
# DASHBOARD_URL=http://localhost:13001
# DASHBOARD_PUBLIC_API_URL=http://localhost:18056
# DASHBOARD_PUBLIC_WS_URL=ws://localhost:18056/ws
# DASHBOARD_ALLOW_REGISTRATIONS=true

# Where a person's own terminal lives — the origin every SCAFFOLD link is built on (PRD §5.5), and
# the same variable the flows lane already reads. Unset, agent-api's mint route answers 503 and the
# step that was about to send does not: a link with no origin is a touch nobody can open, and it is
# only visible at the CLICK unless the mint refuses. TINA_UI_URL being set nowhere is exactly how
# every deeplink the rig ever minted pointed at a port nothing serves.
TINA_UI_URL=

# ── flows: the reaction engine (flows-api) and its mail lane (flows-mailbox, profile `mailbox`) ──
# Every key below is declared in core/flows/src/config.v1.json and checked against docker-compose.yml
# by gate:config-contract. Both flows lanes read the same set: they are one image under two commands.

# The operator key gating POST /flows and POST /events. NO DEFAULT ON PURPOSE — flows refuses to
# start without it, and refuses the published placeholders (`changeme`, `tina-internal-secret`, …)
# by name. `openssl rand -hex 32`.
TINA_FLOWS_API_KEY=
# admin-api's admin key under the name flows reads it by. Defaults to ADMIN_TOKEN; set it only to
# give flows a different credential from the one the rest of the stack uses.
TINA_FLOWS_ADMIN_KEY=
# A read-only key that opens GET /timeline and nothing else. Unset, only the operator key does.
TINA_FLOWS_TIMELINE_KEY=
# Where the assembler asks flows for its tool manifest. Defaults to the service; set it EMPTY to run
# a deployment that does not carry the flows domain at all.
TINA_FLOWS_API_URL=
FLOWS_API_HOST_PORT=18200

# The mailbox. Empty = no mail intake, which is what the `mailbox` profile being off means.
TINA_MAIL_ADDR=
TINA_MAIL_APP_PASSWORD=
TINA_MAIL_INBOX=imap
TINA_MAIL_SMTP_HOST=
TINA_MAIL_SMTP_PORT=25
TINA_MAILPIT_URL=
TINA_MAILPIT_LOOKBACK_S=300
TINA_NOTIFY_CHANNEL=smtp
# WHO THE MAILBOX WILL ACT FOR (R-B12). UNSET IS NOT `EVERYONE` — it means the mailbox's own
# domain, so empty is the safe value here and not a hole. Comma-separated, with or without a `@`.
TINA_FLOWS_MAIL_DOMAINS=
# `1` answers a quarantined stranger ONCE with a fixed one-liner. Off by default: any automatic
# reply to an unverified sender is a reflector.
TINA_FLOWS_MAIL_QUARANTINE_REPLY=
# The ceilings on what one inbox can cost, per sender and for the whole deployment, per window.
TINA_FLOWS_MAIL_RATE_PER_SENDER=12
TINA_FLOWS_MAIL_RATE_GLOBAL=120
TINA_FLOWS_MAIL_RATE_WINDOW_S=3600
TINA_FLOWS_MAIL_BODY_MAX=4000

# The OUTBOUND fan-out allow-list; unset = the organizer's own domain. And this deployment's own
# sentence about where the words live, carried in what it mails.
TINA_FLOWS_ATTENDEE_DOMAINS=
TINA_FLOWS_DATA_STATEMENT=
# A private behavior tree mounted over the showcase baked into the image (PRD decision 12).
# EMPTY IS THE OSS PRODUCT.
TINA_BEHAVIOR_DIR=
TINA_FLOWS_USER_KEY_TTL_S=900
TINA_TIMELINE_SCAN_ROWS=2000

# Opt-in Google Meet bot-hosted Hey TINA + shared TTS (adds Compose speech profile).
# TTS_API_TOKEN must be loaded from private/encrypted configuration. No participant key is needed.
TINA_MEETING_VOICE=0
# TTS_SERVICE_URL=http://tts:8000

# Experimental server-side VieGem name prior; keep off until paired real-audio acceptance.
TINA_VIEGEM_NAME_BIAS=0
