# =============================================================================
# Transcription service (separate GPU deploy unit). Copy to .env:  cp .env.example .env
# =============================================================================

# Host-only probe port; TINA reaches the API over its main Docker network.
TRANSCRIPTION_LB_PORT=8083

# Match the main Compose project name. Default deploy/compose project: tina-v012_tina.
TINA_MAIN_NETWORK=tina-v012_tina

# Model. Multilingual: tiny · base · small · medium · large-v2 · large-v3 · large-v3-turbo
# GPU recommendation: large-v3-turbo + int8 (~2.1 GB VRAM, >10x real-time, 99+ langs).
MODEL_SIZE=large-v3-turbo

# int8 (default; 50-60% VRAM cut, minimal accuracy loss) · float16 (GPU only, fastest, more VRAM)
COMPUTE_TYPE=int8

# CPU only (docker-compose.cpu.yml): physical cores, 0 = auto-detect.
CPU_THREADS=0

# Image tag built for the worker.
IMAGE_TAG=dev

# Shared secret. Match TRANSCRIPTION_SERVICE_TOKEN for the deployment-default route, or the
# NVIDIA GPU token in Settings → Models → Global transcription backend when exposing this as an
# NVIDIA choice. Empty = open (dev only); an empty token cannot be selected as the NVIDIA backend.
API_TOKEN=
