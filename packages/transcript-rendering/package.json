{
  "name": "@tina/transcript-rendering",
  "version": "0.4.1",
  "private": true,
  "description": "Real-time transcript state management: confirmed/pending two-map model, deduplication, speaker grouping",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "transcript",
    "deduplication",
    "websocket",
    "speech-to-text",
    "tina"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": ">=8.5.23",
    "nanoid": "^3.3.18"
  },
  "license": "Apache-2.0"
}
