{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tina:schemas/meeting-memory.v1",
  "title": "meeting-memory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meeting_id",
    "canonical_revision",
    "extractor",
    "windows",
    "facts"
  ],
  "properties": {
    "version": {
      "const": "meeting-memory.v1"
    },
    "meeting_id": {
      "type": "integer",
      "minimum": 1
    },
    "canonical_revision": {
      "type": "integer",
      "minimum": 1
    },
    "extractor": {
      "const": "rules.vi-en.v1"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_revision",
          "start_ms",
          "end_ms",
          "evidence",
          "facts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_ms": {
            "type": "number"
          },
          "end_ms": {
            "type": "number"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "revision",
                "start_ms",
                "end_ms",
                "speaker_id",
                "speaker_name",
                "quote"
              ],
              "properties": {
                "segment_id": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_ms": {
                  "type": "number"
                },
                "end_ms": {
                  "type": "number"
                },
                "speaker_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_name": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "text",
                "status",
                "assignee_id",
                "deadline_text",
                "deadline_date",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "action_item",
                    "decision",
                    "fact"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "status": {
                  "const": "candidate"
                },
                "assignee_id": {
                  "type": "null"
                },
                "deadline_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "deadline_date": {
                  "type": "null"
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "segment_id",
                      "revision",
                      "start_ms",
                      "end_ms",
                      "speaker_id",
                      "speaker_name",
                      "quote"
                    ],
                    "properties": {
                      "segment_id": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "start_ms": {
                        "type": "number"
                      },
                      "end_ms": {
                        "type": "number"
                      },
                      "speaker_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "speaker_name": {
                        "type": "string"
                      },
                      "quote": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "text",
          "status",
          "assignee_id",
          "deadline_text",
          "deadline_date",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "action_item",
              "decision",
              "fact"
            ]
          },
          "text": {
            "type": "string"
          },
          "status": {
            "const": "candidate"
          },
          "assignee_id": {
            "type": "null"
          },
          "deadline_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline_date": {
            "type": "null"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "revision",
                "start_ms",
                "end_ms",
                "speaker_id",
                "speaker_name",
                "quote"
              ],
              "properties": {
                "segment_id": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "start_ms": {
                  "type": "number"
                },
                "end_ms": {
                  "type": "number"
                },
                "speaker_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_name": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
