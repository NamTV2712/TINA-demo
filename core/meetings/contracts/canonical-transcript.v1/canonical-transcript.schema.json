{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tina:schemas/canonical-transcript.v1",
  "title": "canonical-transcript.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meeting_id",
    "revision",
    "source_revision",
    "updated_at",
    "segments"
  ],
  "properties": {
    "version": {
      "const": "canonical-transcript.v1"
    },
    "meeting_id": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "segments": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "start_ms",
          "end_ms",
          "raw_text",
          "text",
          "revision",
          "audio",
          "speaker_id",
          "speaker_name",
          "speaker_revision",
          "words",
          "phrases",
          "alignment"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "start_ms": {
            "type": "number"
          },
          "end_ms": {
            "type": "number"
          },
          "raw_text": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "audio": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "recording_id",
                    "session_id",
                    "start_ms",
                    "end_ms"
                  ],
                  "properties": {
                    "kind": {
                      "const": "recording-span"
                    },
                    "recording_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "session_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "start_ms": {
                      "type": "number"
                    },
                    "end_ms": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "chunk_id",
                    "session_id",
                    "channel",
                    "start_ms",
                    "end_ms",
                    "kind",
                    "chunk_count"
                  ],
                  "properties": {
                    "chunk_id": {
                      "type": "string"
                    },
                    "session_id": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "start_ms": {
                      "type": "number"
                    },
                    "end_ms": {
                      "type": "number"
                    },
                    "kind": {
                      "const": "capture-span"
                    },
                    "chunk_count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "description": "A bounded capture span on one session/channel. chunk_id anchors one retained frame in the span; chunk_count counts matching frames. Use the segment audio endpoint for the complete clip, including gaps."
                }
              ]
            }
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "speaker_name": {
            "type": "string"
          },
          "speaker_revision": {
            "type": "integer",
            "minimum": 0
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "text",
                "start_ms",
                "end_ms",
                "aligned",
                "speaker_id",
                "speaker_name",
                "speaker_source"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                },
                "start_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "end_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "aligned": {
                  "type": "boolean"
                },
                "speaker_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_name": {
                  "type": "string"
                },
                "speaker_source": {
                  "enum": [
                    "confirmed",
                    "diarization",
                    "unknown"
                  ]
                }
              }
            }
          },
          "phrases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker_id",
                "speaker_name",
                "text",
                "start_ms",
                "end_ms",
                "word_indices"
              ],
              "properties": {
                "speaker_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "speaker_name": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "start_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "end_ms": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "word_indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "alignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "job_id",
              "model",
              "audio_sha256",
              "text_sha256"
            ],
            "properties": {
              "status": {
                "enum": [
                  "aligned",
                  "segment_fallback"
                ]
              },
              "job_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "audio_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
