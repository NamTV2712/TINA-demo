{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tina:schemas/stt-foundation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meeting_uid",
    "authority",
    "locator",
    "sequence",
    "fingerprint",
    "sources",
    "segments"
  ],
  "properties": {
    "version": {
      "const": "stt-foundation.v1"
    },
    "meeting_uid": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "instance_id"
      ],
      "properties": {
        "system": {
          "enum": [
            "desktop",
            "meeting-api"
          ]
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "native_meeting_id",
        "local_meeting_id"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "native_meeting_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "local_meeting_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "session_id",
          "channel",
          "sample_rate",
          "start_sample",
          "start_us",
          "clock_quality"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "session_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sample_rate": {
            "const": 16000
          },
          "start_sample": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "start_us": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clock_quality": {
            "enum": [
              "samples",
              "decoded",
              "unknown"
            ]
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "segment_uid",
          "start_us",
          "end_us",
          "raw_text",
          "text",
          "revision",
          "speaker",
          "history",
          "audio"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "segment_uid": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "raw_text": {
            "type": "string",
            "maxLength": 10000
          },
          "text": {
            "type": "string",
            "maxLength": 10000
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "speaker": {
            "type": "string",
            "maxLength": 512
          },
          "history": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision",
                "text",
                "kind",
                "at"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "text": {
                  "type": "string",
                  "maxLength": 10000
                },
                "kind": {
                  "enum": [
                    "manual",
                    "restore",
                    "refinement"
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "audio": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "start_sample",
                "end_sample",
                "start_us",
                "end_us"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "start_sample": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_sample": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "start_us": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_us": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "speaker_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
