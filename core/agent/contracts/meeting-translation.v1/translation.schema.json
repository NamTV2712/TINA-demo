{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tina:schemas:meeting-translation.v1",
  "title": "meeting-translation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "meeting_id",
    "target_language",
    "status",
    "retry_after",
    "total",
    "completed",
    "segments"
  ],
  "properties": {
    "version": {
      "const": "meeting-translation.v1"
    },
    "meeting_id": {
      "type": "integer",
      "minimum": 1
    },
    "target_language": {
      "const": "en"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "paused",
        "complete"
      ]
    },
    "retry_after": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "segments": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "source_text",
          "translated_text"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "source_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "translated_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 50000
          }
        }
      }
    }
  }
}
