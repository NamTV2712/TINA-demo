{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TINA Capture",
  "version": "0.1.0",
  "identifier": "local.tina.capture",
  "build": {"frontendDist": "../ui"},
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {"label": "main", "title": "TINA Capture", "width": 1280, "height": 840, "minWidth": 960, "minHeight": 640},
      {
        "label": "overlay",
        "url": "overlay.html",
        "width": 460,
        "height": 138,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "subtitles",
        "url": "subtitles.html",
        "width": 760,
        "height": 220,
        "minWidth": 420,
        "minHeight": 120,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"}
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": ["icons/icon.icns"],
    "resources": {
      "../../../licenses/aec-rs-sys-1.0.0.LICENSE.txt": "licenses/aec-rs-sys-1.0.0.LICENSE.txt",
      "../../../licenses/speexdsp-1.2.1.COPYING.txt": "licenses/speexdsp-1.2.1.COPYING.txt"
    },
    "macOS": {"minimumSystemVersion": "15.0", "infoPlist": "Info.plist", "entitlements": "Entitlements.plist", "signingIdentity": "-"}
  }
}
