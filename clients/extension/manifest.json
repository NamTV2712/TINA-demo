{
  "manifest_version": 3,
  "name": "TINA Transcript Viewer",
  "version": "0.1.0",
  "description": "Read authorized transcripts from TINA Terminal and the Desktop archive. This extension does not capture audio.",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "viewer-background.js"
  },
  "action": {
    "default_title": "Open TINA Transcript Viewer",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
